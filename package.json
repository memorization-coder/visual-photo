{
  "name": "visual-photo",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "build": "pnpm -r build",
    "check:all": "pnpm check:contracts && pnpm check:primitives && pnpm lint && pnpm typecheck",
    "check:contracts": "node scripts/check-contracts.mjs",
    "generate:contracts": "node scripts/generate-contract-docs.mjs",
    "check:primitives": "pnpm --filter @visual-photo/web run check:primitives",
    "ci": "pnpm check:all && pnpm test && pnpm build",
    "typecheck": "pnpm --filter @visual-photo/contracts build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e:host": "pnpm --filter @visual-photo/web run test:e2e",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
